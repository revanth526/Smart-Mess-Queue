generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum Role {
  STUDENT
  MESS_ADMIN
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
}

enum BookingStatus {
  BOOKED
  CHECKED_IN
  WAITING
  SERVING
  SERVED
  CANCELLED
  NO_SHOW
  WALK_IN
}

enum EntryType {
  BOOKING
  WALK_IN
}

enum QueueStatus {
  CHECKED_IN
  WAITING
  SERVING
  SERVED
  NO_SHOW
}

// ============================================================
// MODELS
// ============================================================

/// Student or admin user account.
model User {
  id           String   @id @default(uuid())
  name         String
  email        String?  @unique
  studentId    String?  @unique
  rollNo       String?  @unique
  passwordHash String
  role         Role     @default(STUDENT)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now()) @db.Timestamptz
  updatedAt    DateTime @updatedAt      @db.Timestamptz

  bookings      Booking[]
  feedbacks     Feedback[]
  foodLogs      FoodLog[]      @relation("FoodLogger")
  refreshTokens RefreshToken[]
  queueEntries  QueueEntry[]

  @@map("users")
}

/// Physical dining hall / mess.
model Mess {
  id            String   @id @default(uuid())
  name          String
  location      String?
  totalCapacity Int
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now()) @db.Timestamptz
  updatedAt     DateTime @updatedAt      @db.Timestamptz

  mealConfigs MealConfig[]
  menuItems   MenuItem[]
  menus       Menu[]
  foodLogs    FoodLog[]

  @@map("messes")
}

/// Configurable meal timing and slot rules.
model MealConfig {
  id                        String   @id @default(uuid())
  messId                    String
  mealType                  MealType
  startTime                 String   // "07:30" wall-clock IST HH:mm
  endTime                   String   // "09:30" wall-clock IST HH:mm
  slotDurationMinutes       Int      @default(20)
  bookingCutoffMinutes      Int      @default(30)
  cancellationCutoffMinutes Int      @default(30)
  defaultSlotCapacity       Int      @default(50)
  averageServingTimeSeconds Int      @default(30)
  isActive                  Boolean  @default(true)
  createdAt                 DateTime @default(now()) @db.Timestamptz
  updatedAt                 DateTime @updatedAt      @db.Timestamptz

  mess Mess @relation(fields: [messId], references: [id], onDelete: Restrict)

  @@unique([messId, mealType])
  @@map("meal_configs")
}

/// Reusable dish catalog (master list).
model MenuItem {
  id                  String   @id @default(uuid())
  messId              String
  name                String
  category            String?
  defaultServingGrams Int?
  isAvailable         Boolean  @default(true)
  createdAt           DateTime @default(now()) @db.Timestamptz
  updatedAt           DateTime @updatedAt      @db.Timestamptz

  mess       Mess       @relation(fields: [messId], references: [id], onDelete: Restrict)
  menuDishes MenuDish[]

  @@unique([messId, name])
  @@index([messId, isAvailable])
  @@map("menu_items")
}

/// A specific meal service occurrence on a specific date.
model Menu {
  id        String   @id @default(uuid())
  messId    String
  date      DateTime @db.Date
  mealType  MealType
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt      @db.Timestamptz

  mess        Mess         @relation(fields: [messId], references: [id], onDelete: Restrict)
  dishes       MenuDish[]
  slots        TimeSlot[]
  bookings     Booking[]
  foodLogs     FoodLog[]
  feedbacks    Feedback[]
  queueEntries QueueEntry[]

  @@unique([messId, date, mealType])
  @@index([date, mealType])
  @@index([messId, date])
  @@map("menus")
}

/// Snapshot of a dish served at a specific Menu occurrence.
model MenuDish {
  id           String   @id @default(uuid())
  menuId       String
  menuItemId   String?
  dishName     String
  dishCategory String?
  servingGrams Int?
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now()) @db.Timestamptz

  menu        Menu         @relation(fields: [menuId], references: [id], onDelete: Cascade)
  menuItem    MenuItem?    @relation(fields: [menuItemId], references: [id], onDelete: SetNull)

  @@index([menuId])
  @@map("menu_dishes")
}

/// Bookable time window within a meal service.
model TimeSlot {
  id              String   @id @default(uuid())
  menuId          String
  startTime       DateTime @db.Timestamptz
  endTime         DateTime @db.Timestamptz
  capacity        Int
  currentBookings Int      @default(0)
  createdAt       DateTime @default(now()) @db.Timestamptz

  menu         Menu         @relation(fields: [menuId], references: [id], onDelete: Cascade)
  bookings     Booking[]
  queueEntries QueueEntry[]

  @@index([menuId])
  @@index([menuId, startTime])
  @@map("time_slots")
}

/// Student's meal lifecycle record.
model Booking {
  id          String        @id @default(uuid())
  studentId   String
  menuId      String
  slotId      String?
  status      BookingStatus @default(BOOKED)
  entryType   EntryType     @default(BOOKING)

  // Lifecycle timestamps
  bookedAt    DateTime? @db.Timestamptz
  checkedInAt DateTime? @db.Timestamptz
  waitingAt   DateTime? @db.Timestamptz
  servingAt   DateTime? @db.Timestamptz
  servedAt    DateTime? @db.Timestamptz
  cancelledAt DateTime? @db.Timestamptz
  noShowAt    DateTime? @db.Timestamptz

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt      @db.Timestamptz

  student    User        @relation(fields: [studentId], references: [id], onDelete: Restrict)
  menu       Menu        @relation(fields: [menuId], references: [id], onDelete: Restrict)
  slot       TimeSlot?   @relation(fields: [slotId], references: [id], onDelete: Restrict)
  queueEntry QueueEntry?
  feedback   Feedback?

  @@unique([studentId, menuId])
  @@index([menuId, status])
  @@index([studentId, status])
  @@index([menuId, entryType])
  @@index([slotId])
  @@index([status, waitingAt])
  @@map("bookings")
}

/// Real-time live queue entry for physical mess dining service.
model QueueEntry {
  id                String      @id @default(uuid())
  menuId            String
  slotId            String?
  bookingId         String?     @unique
  studentId         String?
  entryType         EntryType   @default(BOOKING)
  status            QueueStatus @default(CHECKED_IN)
  sequenceNumber    Int
  studentIdentifier String?
  checkedInAt       DateTime    @default(now()) @db.Timestamptz
  servingStartedAt  DateTime?   @db.Timestamptz
  servedAt          DateTime?   @db.Timestamptz
  createdAt         DateTime    @default(now()) @db.Timestamptz
  updatedAt         DateTime    @updatedAt      @db.Timestamptz

  menu    Menu      @relation(fields: [menuId], references: [id], onDelete: Restrict)
  slot    TimeSlot? @relation(fields: [slotId], references: [id], onDelete: SetNull)
  booking Booking?  @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  student User?     @relation(fields: [studentId], references: [id], onDelete: SetNull)

  @@unique([menuId, sequenceNumber])
  @@index([menuId, status])
  @@index([studentId, status])
  @@index([slotId])
  @@index([status, sequenceNumber])
  @@map("queue_entries")
}

/// Food preparation, serving, and waste log.
model FoodLog {
  id          String   @id @default(uuid())
  messId      String
  menuId      String?
  date        DateTime @db.Date
  mealType    MealType
  preparedKg  Float
  servedKg    Float
  wastedKg    Float
  notes       String?
  createdById String
  createdAt   DateTime @default(now()) @db.Timestamptz
  updatedAt   DateTime @updatedAt      @db.Timestamptz

  mess      Mess     @relation(fields: [messId], references: [id], onDelete: Restrict)
  menu      Menu?    @relation(fields: [menuId], references: [id], onDelete: SetNull)
  createdBy User     @relation("FoodLogger", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([messId, date, mealType])
  @@index([messId, date])
  @@index([date, mealType])
  @@index([menuId])
  @@index([createdById])
  @@map("food_logs")
}

/// Student's meal rating for a completed meal.
model Feedback {
  id        String   @id @default(uuid())
  studentId String
  bookingId String   @unique
  menuId    String
  rating    Int
  comment   String?
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt      @db.Timestamptz

  student User    @relation(fields: [studentId], references: [id], onDelete: Restrict)
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  menu    Menu    @relation(fields: [menuId], references: [id], onDelete: Restrict)

  @@index([studentId])
  @@index([menuId])
  @@map("feedbacks")
}

/// JWT refresh token for session management.
model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime @db.Timestamptz
  isRevoked Boolean  @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRevoked])
  @@index([expiresAt])
  @@map("refresh_tokens")
}
