# ── Database ──────────────────────────────────────────────────
# In production, use SSL mode and strong credentials:
# postgresql://<user>:<password>@<host>:<port>/<dbname>?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/smart_mess_dev

# ── JWT Secrets (REQUIRED: generate unique random 64-char strings in production) ──
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=CHANGE_ME_access_secret_dev_only
JWT_REFRESH_SECRET=CHANGE_ME_refresh_secret_dev_only
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# ── Server ───────────────────────────────────────────────────
SERVER_PORT=3000
NODE_ENV=development

# ── Client (Allowed CORS Origin) ──────────────────────────────
CLIENT_URL=http://localhost:5173

# ── Bcrypt Hashing ───────────────────────────────────────────
# Use 12 rounds in production for secure hashing
BCRYPT_ROUNDS=12

