# ── Database ──────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/smart_mess_dev

# ── JWT Secrets (REPLACE in production) ──────────────────────
JWT_ACCESS_SECRET=CHANGE_ME_access_secret_dev_only
JWT_REFRESH_SECRET=CHANGE_ME_refresh_secret_dev_only
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# ── Server ───────────────────────────────────────────────────
SERVER_PORT=3000
NODE_ENV=development

# ── Client ───────────────────────────────────────────────────
CLIENT_URL=http://localhost:5173

# ── Bcrypt ───────────────────────────────────────────────────
BCRYPT_ROUNDS=12
